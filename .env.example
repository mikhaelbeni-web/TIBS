# Configuration Firebase (console Firebase > Paramètres du projet > Vos applications)
# Ces valeurs sont publiques côté navigateur : la sécurité repose sur les règles Firestore.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=tiibs-2ac00.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=tiibs-2ac00
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=tiibs-2ac00.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=1092105105103
NEXT_PUBLIC_FIREBASE_APP_ID=1:1092105105103:web:1c30ff93a05dd4b84f11ba
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-8XT6LM6EVS

# Développement local avec les émulateurs Firebase (npm run emulators) : mettre 1
NEXT_PUBLIC_USE_EMULATORS=0

# --- Côté serveur uniquement (Vercel > Settings > Environment Variables, type Secret) ---
# Clé de compte de service Firebase (console > Paramètres du projet > Comptes de service > Générer une clé),
# contenu du fichier JSON collé tel quel (ou encodé en base64 : base64 -w0 cle.json)
FIREBASE_SERVICE_ACCOUNT=
# Jeton (64 caractères aléatoires) partagé avec la tâche quotidienne qui lit les mails : openssl rand -hex 32
INGEST_TOKEN=

# --- Lecture automatique de la boîte mail du restaurant (Gmail) ---
# Identifiants OAuth « Application Web » créés dans la console Google Cloud (projet tiibs-2ac00),
# URI de redirection autorisée : https://<domaine de l'app>/api/gmail/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Facultatif : adresse publique de l'app (sinon déduite de la requête) et boîte proposée à la connexion
APP_URL=
MAIL_ADDRESS=ava01012018@gmail.com
# Secret envoyé par Vercel Cron à /api/cron/mail (32 caractères aléatoires ou plus) : openssl rand -hex 32
CRON_SECRET=
# Facultatif : clé API Claude (console.anthropic.com) pour lire les PDF et pré-remplir les montants.
# Sans clé, les factures arrivent « à compléter » dans À vérifier.
ANTHROPIC_API_KEY=
